<!DOCTYPE html><html lang="en"><head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
    <title>{{ $global.title }}</title>
  <script s:ns="" s:cn="" s:hash="script_5f50a1db8f374703" src="/assets/libsui.min.js" type="text/javascript" name="libsui"></script>
<style s:ns="ns_a17c1dec10d62df5" s:cn="__page" rel="stylesheet" type="text/css">
:root{color-scheme:light;--bg: #f4f6fb;--card: #ffffff;--text: #111827;--muted: #6b7280;--line: #e5e7eb;--accent: #2563eb;--ok: #059669;--warn: #d97706}*{box-sizing:border-box}body{margin:0;background:radial-gradient(1100px 500px at 10% -10%,#dbeafe 0%,transparent 55%),var(--bg);color:var(--text);font-family:ui-sans-serif,-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif;line-height:1.55}.page{max-width:1120px;margin:0 auto;padding:40px 24px 56px}.hero{padding:12px 0 28px}.eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.12em;color:var(--accent);text-transform:uppercase}.dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 4px #0596691f}h1{margin:14px 0 8px;font-size:clamp(32px,5vw,54px);letter-spacing:-.04em;line-height:1.05}.lede{margin:0;max-width:760px;color:var(--muted);font-size:16px}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.btn{display:inline-flex;align-items:center;padding:9px 14px;border-radius:8px;border:1px solid var(--line);color:var(--text);text-decoration:none;font-size:14px;font-weight:600;background:var(--card)}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px;margin-top:20px}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;box-shadow:0 12px 30px #0f172a0d}.card h2{margin:0 0 12px;font-size:16px}.badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px;font-weight:700}.ok{color:var(--ok);background:#0596691a}.warn{color:var(--warn);background:#d977061a}table{width:100%;border-collapse:collapse}td{padding:8px 0;border-bottom:1px solid var(--line);font-size:14px;vertical-align:top;word-break:break-word}tr:last-child td{border-bottom:0}td:first-child{width:32%;color:var(--muted);white-space:nowrap}td:last-child{text-align:left;padding-left:12px}code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;word-break:break-all}.footer{margin-top:28px;color:var(--muted);font-size:12px;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between}

</style>
</head>
  <body s:ns="ns_a17c1dec10d62df5" s:public="/" s:assets="/assets">
    <div class="page">
  <header class="hero">
    <span class="eyebrow"><span class="dot"></span> Yao UAT · Local</span>
    <h1>Yao Agents<br/>UAT Environment</h1>
    <p class="lede">
      Source-run Yao UAT for CUI integration and manual testing.
      Connected to Tao UAT, with the local Tai transport on port 6099.
    </p>
    <div class="actions">
      <a class="btn primary" href="/v1/user/entry">Sign in</a>
      <a class="btn" href="/v1/oauth/jwks" target="_blank">JWKS</a>
      <a class="btn" href="{{ env.CUI_URL }}" target="_blank">Open CUI</a>
      <a class="btn" href="https://github.com/YaoApp/yaoagents-releases" target="_blank">Reference</a>
    </div>
  </header>

  <main class="grid">
    <section class="card">
      <h2>Runtime</h2>
      <table>
        <tbody><tr><td>Application</td><td><code>{{ $global.title }}</code></td></tr>
        <tr><td>Yao Engine</td><td><code>v{{ yao.version }}</code></td></tr>
        <tr><td>Environment</td><td><code>{{ env.YAO_ENV }}</code></td></tr>
        <tr><td>Listen</td><td><code>{{ env.YAO_HOST }}:{{ env.YAO_PORT }}</code></td></tr>
        <tr><td>Request host</td><td><code>{{ $url.host }}</code></td></tr>
        <tr><td>Server URL</td><td><code>{{ env.SERVER }}</code></td></tr>
        <tr><td>OAuth issuer</td><td><code>{{ env.OAUTH_ISSUER }}</code></td></tr>
        <tr><td>Build</td><td><span class="badge warn">{{ env.BUILD }}</span></td></tr>
      </tbody></table>
    </section>

    <section class="card">
      <h2>Tao UAT</h2>
      <table>
        <tbody><tr><td>Status</td><td><span class="badge ok">{{ env.TAO_STATUS }}</span></td></tr>
        <tr><td>Issuer</td><td><code>{{ env.TAO_ISSUER }}</code></td></tr>
        <tr><td>Client</td><td><code>{{ env.TAO_CLIENT }}</code></td></tr>
        <tr><td>Callback</td><td><code>http://{{ $url.host }}/v1/user/oauth/tao/callback</code></td></tr>
      </tbody></table>
    </section>

    <section class="card">
      <h2>Tai / Computer</h2>
      <table>
        <tbody><tr><td>Tai server</td><td><span class="badge ok">{{ env.TAI_STATUS }}</span></td></tr>
        <tr><td>Transport port</td><td><code>{{ env.TAI_TRANSPORT }}</code></td></tr>
        <tr><td>OpenAPI gRPC</td><td><code>{{ env.OPENAPI_GRPC }}</code></td></tr>
        <tr><td>Transport discovery</td><td><a href="/.well-known/yao-transport" target="_blank">/.well-known/yao-transport</a></td></tr>
      </tbody></table>
    </section>

    <section class="card">
      <h2>Database</h2>
      <table>
        <tbody><tr><td>Driver</td><td><code>{{ env.YAO_DB_DRIVER }}</code></td></tr>
        <tr><td>Target</td><td><code>{{ env.DB_TARGET }}</code></td></tr>
        <tr><td>DSN</td><td><code>{{ env.YAO_DB_PRIMARY }}</code></td></tr>
      </tbody></table>
    </section>

    <section class="card">
      <h2>CUI</h2>
      <table>
        <tbody><tr><td>Dev server</td><td><a href="{{ env.CUI_URL }}" target="_blank">{{ env.CUI_URL }}</a></td></tr>
        <tr><td>Proxy</td><td><code>http://127.0.0.1:5199/v1/*</code></td></tr>
        <tr><td>API base</td><td><code>/v1</code></td></tr>
      </tbody></table>
    </section>

    <section class="card">
      <h2>Application root</h2>
      <table>
        <tbody><tr><td>Source</td><td><code>{{ env.APP_ROOT }}</code></td></tr>
        <tr><td>Template</td><td><code>data/templates/default</code></td></tr>
        <tr><td>Health</td><td><a href="/v1/user/entry" target="_blank">/v1/user/entry</a></td></tr>
      </tbody></table>
    </section>
  </main>

  <footer class="footer">
    <span>Yao UAT · source-run via bin/yao-dev</span>
    <span>Tao UAT: https://tao.dev.yaoagents.cn</span>
  </footer>
</div>

  



<script name="config" type="json">
{"cacheStore":"","cache":0,"dataCache":0,"api":null,"root":"/","markdown":null,"title":"","guard":""}
</script>



<script name="data" type="json">
{
  "$yao": "utils.app.Ping",
  "$env": "@GetEnv"
}

</script>



<script name="global" type="json">
{
  "title": "Yao UAT"
}

</script>



<script name="imports" type="json">
{}
</script>

</body></html>