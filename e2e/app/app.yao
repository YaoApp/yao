{
  "name": "Yao Agents E2E",
  "short": "Yao Agents E2E",
  "description": "E2E test application for Yao Agents 2.0",
  "version": "2.0.0",
  "public": {
    "sourceRoots": { "/public": "/data/templates/default" },
    "rewrite": [
      { "^\\/assets\\/(.*)$": "/assets/$1" },
      { "^\\/(.*)$": "/$1.sui" }
    ]
  }
}
