{
  "name": "workspace_git_credential",
  "description": "Manage workspace HTTPS Git credentials (set/list/delete tokens by host)",
  "process": "tools.workspace_git_credential",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace_id": {
        "type": "string",
        "description": "Workspace ID"
      },
      "action": {
        "type": "string",
        "enum": ["set", "list", "delete"],
        "description": "Action: set, list, or delete credential"
      },
      "host": {
        "type": "string",
        "description": "Git host, e.g. github.com (required for set/delete)"
      },
      "username": {
        "type": "string",
        "description": "Username (optional, defaults to x-access-token)"
      },
      "token": {
        "type": "string",
        "description": "Access token (required for set)"
      }
    },
    "required": ["workspace_id", "action"]
  },
  "x-process-args": ["$args.workspace_id", "$args.action", "$args.host", "$args.username", "$args.token"]
}
