{
  "name": "task_create",
  "description": "Create a new task on the kanban board",
  "process": "tools.task_create",
  "inputSchema": {
    "type": "object",
    "properties": {
      "title": { "type": "string", "description": "Task title" },
      "assistant_id": { "type": "string", "description": "AI assistant to use" },
      "column_id": { "type": "string", "description": "Target column ID" }
    },
    "required": ["title", "assistant_id", "column_id"]
  },
  "x-process-args": ["$args.title", "$args.assistant_id", "$args.column_id"]
}
