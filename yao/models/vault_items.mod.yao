{
  "name": "VaultItems",
  "label": "VaultItems",
  "description": "Credential item under a vault group or vault.",
  "tags": [
    "system",
    "2.0"
  ],
  "builtin": true,
  "readonly": true,
  "sort": 100,
  "table": {
    "name": "vault_items",
    "comment": "Credential item under a vault group or vault."
  },
  "columns": [
    {
      "name": "id",
      "label": "Id",
      "comment": "Primary key",
      "type": "string",
      "length": 32,
      "primary": true,
      "nullable": false
    },
    {
      "name": "vault_id",
      "label": "Vault Id",
      "comment": "Owner vault ID",
      "type": "string",
      "length": 64,
      "index": true
    },
    {
      "name": "group_id",
      "label": "Group Id",
      "comment": "Vault group identifier; NULL means ungrouped",
      "type": "string",
      "length": 64,
      "index": true,
      "nullable": true
    },
    {
      "name": "name",
      "label": "Name",
      "comment": "Display name",
      "type": "string",
      "length": 128
    },
    {
      "name": "kind",
      "label": "Kind",
      "comment": "Record kind",
      "type": "string",
      "length": 32
    },
    {
      "name": "description",
      "label": "Description",
      "comment": "Description",
      "type": "text",
      "nullable": true
    },
    {
      "name": "secret_ref",
      "label": "Secret Ref",
      "comment": "Opaque reference to the SecretStore entry",
      "type": "string",
      "length": 255
    },
    {
      "name": "status",
      "label": "Status",
      "comment": "Current status: enabled, rotating, disabled",
      "type": "enum",
      "option": [
        "enabled",
        "rotating",
        "disabled"
      ],
      "default": "enabled",
      "index": true
    },
    {
      "name": "rotation_at",
      "label": "Rotation At",
      "comment": "Last rotation time",
      "type": "timestamp",
      "nullable": true
    },
    {
      "name": "expires_at",
      "label": "Expires At",
      "comment": "Credential expiry; NULL means no expiry",
      "type": "timestamp",
      "nullable": true,
      "index": true
    },
    {
      "name": "last_used_at",
      "label": "Last Used At",
      "comment": "Last resolve/use time",
      "type": "timestamp",
      "nullable": true
    },
    {
      "name": "metadata",
      "label": "Metadata",
      "comment": "Additional metadata",
      "type": "json",
      "nullable": true
    },
    {
      "name": "__i18n",
      "label": "  I18N",
      "comment": "Localized field values keyed by locale",
      "type": "json",
      "nullable": true
    }
  ],
  "indexes": [
    {
      "name": "uk_vi_name",
      "columns": [
        "vault_id",
        "group_id",
        "name"
      ],
      "type": "unique",
      "comment": "Unique item name per group"
    },
    {
      "name": "idx_vi_vault",
      "columns": [
        "vault_id",
        "status"
      ],
      "type": "index",
      "comment": "Vault items"
    }
  ],
  "option": {
    "timestamps": true,
    "soft_deletes": true,
    "permission": true
  }
}
