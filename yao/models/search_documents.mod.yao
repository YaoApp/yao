{
  "name": "SearchDocuments",
  "label": "SearchDocuments",
  "description": "Cross-resource search index entry generated by a scheduled job.",
  "tags": [
    "system",
    "2.0"
  ],
  "builtin": true,
  "readonly": true,
  "sort": 100,
  "table": {
    "name": "search_documents",
    "comment": "Cross-resource search index entry generated by a scheduled job."
  },
  "columns": [
    {
      "name": "id",
      "label": "Id",
      "comment": "Primary key",
      "type": "string",
      "length": 32,
      "primary": true,
      "nullable": false
    },
    {
      "name": "resource_type",
      "label": "Resource Type",
      "comment": "Resource type",
      "type": "string",
      "length": 24
    },
    {
      "name": "resource_id",
      "label": "Resource Id",
      "comment": "Resource identifier",
      "type": "string",
      "length": 64
    },
    {
      "name": "locale",
      "label": "Locale",
      "comment": "Lowercase locale key",
      "type": "string",
      "length": 16,
      "default": ""
    },
    {
      "name": "scope",
      "label": "Scope",
      "comment": "Ownership scope: system, team, user",
      "type": "enum",
      "option": [
        "system",
        "team",
        "user"
      ],
      "nullable": true
    },
    {
      "name": "title",
      "label": "Title",
      "comment": "Title",
      "type": "string",
      "length": 255,
      "nullable": true
    },
    {
      "name": "content",
      "label": "Content",
      "comment": "Searchable content",
      "type": "text",
      "nullable": true
    },
    {
      "name": "keywords",
      "label": "Keywords",
      "comment": "Search keywords",
      "type": "text",
      "nullable": true
    },
    {
      "name": "metadata",
      "label": "Metadata",
      "comment": "Additional metadata",
      "type": "json",
      "nullable": true
    },
    {
      "name": "indexed_at",
      "label": "Indexed At",
      "comment": "Index time",
      "type": "timestamp",
      "index": true
    },
    {
      "name": "__i18n",
      "label": "  I18N",
      "comment": "Localized field values keyed by locale",
      "type": "json",
      "nullable": true
    }
  ],
  "indexes": [
    {
      "name": "uk_search_res",
      "columns": [
        "resource_type",
        "resource_id",
        "locale"
      ],
      "type": "unique",
      "comment": "Unique index"
    },
    {
      "name": "idx_search_scope",
      "columns": [
        "scope",
        "__yao_team_id",
        "locale"
      ],
      "type": "index",
      "comment": "Index index"
    }
  ],
  "option": {
    "timestamps": true,
    "soft_deletes": true,
    "permission": true
  }
}
