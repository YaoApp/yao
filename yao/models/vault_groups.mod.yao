{
  "name": "VaultGroups",
  "label": "VaultGroups",
  "description": "Credential group under a vault.",
  "tags": [
    "system",
    "2.0"
  ],
  "builtin": true,
  "readonly": true,
  "sort": 100,
  "table": {
    "name": "vault_groups",
    "comment": "Credential group under a vault."
  },
  "columns": [
    {
      "name": "id",
      "label": "Id",
      "comment": "Primary key",
      "type": "string",
      "length": 32,
      "primary": true,
      "nullable": false
    },
    {
      "name": "vault_id",
      "label": "Vault Id",
      "comment": "Owner vault ID",
      "type": "string",
      "length": 64,
      "index": true
    },
    {
      "name": "name",
      "label": "Name",
      "comment": "Display name",
      "type": "string",
      "length": 128,
      "index": true
    },
    {
      "name": "description",
      "label": "Description",
      "comment": "Description",
      "type": "text",
      "nullable": true
    },
    {
      "name": "permission_label",
      "label": "Permission Label",
      "comment": "Display permission label",
      "type": "string",
      "length": 64,
      "nullable": true
    },
    {
      "name": "status",
      "label": "Status",
      "comment": "Current status: enabled, disabled, archived",
      "type": "enum",
      "option": [
        "enabled",
        "disabled",
        "archived"
      ],
      "default": "enabled"
    },
    {
      "name": "position",
      "label": "Position",
      "comment": "Sort position",
      "type": "integer",
      "default": 0
    },
    {
      "name": "pinned",
      "label": "Pinned",
      "comment": "Pinned flag",
      "type": "boolean",
      "default": false
    },
    {
      "name": "listed",
      "label": "Listed",
      "comment": "Whether the item appears in lists",
      "type": "boolean",
      "default": true
    },
    {
      "name": "metadata",
      "label": "Metadata",
      "comment": "Additional metadata",
      "type": "json",
      "nullable": true
    },
    {
      "name": "__i18n",
      "label": "  I18N",
      "comment": "Localized field values keyed by locale",
      "type": "json",
      "nullable": true
    }
  ],
  "indexes": [
    {
      "name": "uk_vg_vault_name",
      "columns": [
        "vault_id",
        "name"
      ],
      "type": "unique",
      "comment": "Unique group name per vault"
    },
    {
      "name": "idx_vg_vault",
      "columns": [
        "vault_id",
        "listed",
        "pinned",
        "position"
      ],
      "type": "index",
      "comment": "Vault groups"
    }
  ],
  "option": {
    "timestamps": true,
    "soft_deletes": true,
    "permission": true
  }
}
