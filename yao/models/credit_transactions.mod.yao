      "type": "string",
      "length": 64
    },
    {
      "name": "type",
      "label": "Type",
      "comment": "Record type: grant, consume, refund, topup",
      "type": "enum",
      "option": [
        "grant",
        "consume",
        "refund",
        "topup"
      ]
    },
    {
      "name": "amount",
      "label": "Amount",
      "comment": "Positive transaction amount",
      "type": "decimal",
      "precision": 18,
      "scale": 4
    },
    {
      "name": "balance_after",
      "label": "Balance After",
      "comment": "Account balance after the transaction",
      "type": "decimal",
      "precision": 18,
      "scale": 4
    },
    {
      "name": "order_id",
      "label": "Order Id",
      "comment": "Order identifier",
      "type": "string",
      "length": 64,
      "nullable": true,
      "index": true
    },
    {
      "name": "reason",
      "label": "Reason",
      "comment": "Reason",
      "type": "string",
      "length": 255,
      "nullable": true
    },
    {
      "name": "metadata",
      "label": "Metadata",
      "comment": "Additional metadata",
      "type": "json",
      "nullable": true
    },
    {
      "name": "__i18n",
      "label": "  I18N",
      "comment": "Localized field values keyed by locale",
      "type": "json",
      "nullable": true
    }
  ],
  "indexes": [
