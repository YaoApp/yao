    "2.0"
  ],
  "builtin": true,
  "readonly": true,
  "sort": 100,
  "table": {
    "name": "credit_transactions",
    "comment": "Append-only credit account transaction."
  },
  "columns": [
    {
      "name": "id",
      "label": "Id",
      "comment": "Primary key",
      "type": "string",
      "length": 32,
      "primary": true,
      "nullable": false
    },
    {
      "name": "account_type",
      "label": "Account Type",
      "comment": "Credit account type: team, user",
      "type": "enum",
      "option": [
        "team",
        "user"
      ]
    },
    {
      "name": "account_id",
      "label": "Account Id",
