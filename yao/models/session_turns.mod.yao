      "nullable": true
    },
    {
      "name": "error",
      "label": "Error",
      "comment": "Error message",
      "type": "text",
      "nullable": true
    },
    {
      "name": "computer_id",
      "label": "Computer Id",
      "comment": "Computer identifier",
      "type": "string",
      "length": 64,
      "nullable": true,
      "index": true
    },
    {
      "name": "request_params",
      "label": "Request Params",
      "comment": "Request parameters",
      "type": "json",
      "nullable": true
    },
    {
      "name": "started_at",
      "label": "Started At",
      "comment": "Start time",
      "type": "timestamp",
      "nullable": true
    },
    {
