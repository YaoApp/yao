{
  "name": "Orders",
  "label": "Orders",
  "description": "Cloud computer order and provisioning state.",
  "tags": [
    "system",
    "2.0"
  ],
  "builtin": true,
  "readonly": true,
  "sort": 100,
  "table": {
    "name": "orders",
    "comment": "Cloud computer order and provisioning state."
  },
  "columns": [
    {
      "name": "id",
      "label": "Id",
      "comment": "Primary key",
      "type": "string",
      "length": 32,
      "primary": true,
      "nullable": false
    },
    {
      "name": "order_no",
      "label": "Order No",
      "comment": "Order number",
      "type": "string",
      "length": 64,
      "unique": true
    },
    {
      "name": "product_id",
      "label": "Product Id",
      "comment": "Product identifier",
      "type": "string",
      "length": 64
    },
    {
      "name": "buyer_type",
      "label": "Buyer Type",
      "comment": "Buyer type: team, user",
      "type": "enum",
      "option": [
        "team",
        "user"
      ]
    },
    {
      "name": "buyer_id",
      "label": "Buyer Id",
      "comment": "Buyer identifier",
      "type": "string",
      "length": 64
    },
    {
      "name": "quantity",
      "label": "Quantity",
      "comment": "Quantity",
      "type": "integer",
      "default": 1
    },
    {
      "name": "amount_credits",
      "label": "Amount Credits",
      "comment": "Amount in credits",
      "type": "decimal",
      "precision": 18,
      "scale": 4,
      "default": 0
    },
    {
      "name": "status",
      "label": "Status",
      "comment": "Current status: pending, pending_approval, pending_payment, paid, provisioning, fulfilled, cancelled, refunded",
      "type": "enum",
      "option": [
        "pending",
        "pending_approval",
        "pending_payment",
        "paid",
        "provisioning",
        "fulfilled",
        "cancelled",
        "refunded"
      ],
      "default": "pending"
    },
    {
      "name": "approval_request_id",
      "label": "Approval Request Id",
      "comment": "Related approval request",
      "type": "string",
      "length": 64,
      "nullable": true
    },
    {
      "name": "computer_id",
      "label": "Computer Id",
      "comment": "Computer identifier",
      "type": "string",
      "length": 64,
      "nullable": true,
      "index": true
    },
    {
      "name": "paid_at",
      "label": "Paid At",
      "comment": "Payment time",
      "type": "timestamp",
      "nullable": true
    },
    {
      "name": "fulfilled_at",
      "label": "Fulfilled At",
      "comment": "Fulfillment time",
      "type": "timestamp",
      "nullable": true
    },
    {
      "name": "expires_at",
      "label": "Expires At",
      "comment": "Expiration time",
      "type": "timestamp",
      "nullable": true
    },
    {
      "name": "metadata",
      "label": "Metadata",
      "comment": "Additional metadata",
      "type": "json",
      "nullable": true
    },
    {
      "name": "__i18n",
      "label": "  I18N",
      "comment": "Localized field values keyed by locale",
      "type": "json",
      "nullable": true
    }
  ],
  "indexes": [
    {
      "name": "idx_orders_product",
      "columns": [
        "product_id",
        "status"
      ],
      "type": "index",
      "comment": "Index index"
    },
    {
      "name": "idx_orders_buyer",
      "columns": [
        "buyer_type",
        "buyer_id"
      ],
      "type": "index",
      "comment": "Index index"
    }
  ],
  "option": {
    "timestamps": true,
    "soft_deletes": true,
    "permission": true
  }
}
