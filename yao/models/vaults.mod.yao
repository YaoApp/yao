{
  "name": "Vaults",
  "label": "Vaults",
  "description": "Vault owner boundary.",
  "tags": [
    "system",
    "2.0",
    "vault"
  ],
  "builtin": true,
  "readonly": true,
  "sort": 100,
  "table": {
    "name": "vaults",
    "comment": "Vault owner boundary."
  },
  "columns": [
    {
      "name": "id",
      "label": "Id",
      "comment": "Primary key",
      "type": "string",
      "length": 32,
      "primary": true,
      "nullable": false
    },
    {
      "name": "vault_id",
      "label": "Vault Id",
      "comment": "Public vault ID (vlt_...)",
      "type": "string",
      "length": 64,
      "unique": true
    },
    {
      "name": "name",
      "label": "Name",
      "comment": "Display name",
      "type": "string",
      "length": 128
    },
    {
      "name": "description",
      "label": "Description",
      "comment": "Description",
      "type": "text",
      "nullable": true
    },
    {
      "name": "scope",
      "label": "Scope",
      "comment": "Owner scope: user, team, system",
      "type": "enum",
      "option": [
        "user",
        "team",
        "system"
      ]
    },
    {
      "name": "owner_id",
      "label": "Owner Id",
      "comment": "user_id / team_id / system",
      "type": "string",
      "length": 64,
      "index": true
    },
    {
      "name": "status",
      "label": "Status",
      "comment": "Current status",
      "type": "enum",
      "option": [
        "active",
        "disabled",
        "archived"
      ],
      "default": "active"
    },
    {
      "name": "position",
      "label": "Position",
      "comment": "Sort position",
      "type": "integer",
      "default": 0
    },
    {
      "name": "pinned",
      "label": "Pinned",
      "comment": "Pinned flag",
      "type": "boolean",
      "default": false
    },
    {
      "name": "listed",
      "label": "Listed",
      "comment": "Whether listed",
      "type": "boolean",
      "default": true
    },
    {
      "name": "metadata",
      "label": "Metadata",
      "comment": "Additional metadata",
      "type": "json",
      "nullable": true
    },
    {
      "name": "__i18n",
      "label": "  I18N",
      "comment": "Localized field values",
      "type": "json",
      "nullable": true
    }
  ],
  "indexes": [
    {
      "name": "uk_vaults_owner",
      "columns": [
        "scope",
        "owner_id"
      ],
      "type": "unique",
      "comment": "One vault per owner"
    },
    {
      "name": "idx_vaults_list",
      "columns": [
        "scope",
        "owner_id",
        "listed",
        "pinned",
        "position"
      ],
      "type": "index",
      "comment": "Vault list"
    }
  ],
  "option": {
    "timestamps": true,
    "soft_deletes": true,
    "permission": true
  }
}
